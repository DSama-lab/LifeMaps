# Life Maps — Caddy de produção (TLS automático via Let's Encrypt).
# Usado pelo docker-compose.prod.yml. DOMAIN vem do .env (ex: api.lifemaps.pro).
# Pré-requisito: DNS do domínio apontado p/ a VPS antes do primeiro `up -d`.

{$DOMAIN} {
	encode gzip

	reverse_proxy api:8000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-XSS-Protection 0
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security max-age=31536000;
	}
}

# Opcional: servir o front estático no mesmo Caddy (subdomínio separado sem porta).
# Monte a pasta com o index.html no volume:  ./www:/srv/www/lifemaps:ro
# e defina no .env: {$APP_DOMAIN} (ex: app.lifemaps.pro).
# {$APP_DOMAIN} {
# 	encode gzip
# 	root * /srv/www/lifemaps
# 	try_files {path} /index.html
# 	file_server
# }