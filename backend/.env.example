# ===== Life Maps backend — configuração mínima (exemplo). NUNCA coloque valores reais aqui. =====
# Copie para .env na máquina/VPS e preencha com valores reais.

# Postgres (Docker, rede interna). NUNCA publicar a porta 5432 para a internet.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[DIGITE SUA SENHA POSTGRES AQUI]
POSTGRES_DB=lifemaps
DATABASE_URL=postgresql+psycopg://postgres:[DIGITE SUA SENHA POSTGRES AQUI]@postgres:5432/lifemaps

# Segredos assinatura de sessão — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=[DIGITE SEU SESSION SECRET AQUI]

# Google OAuth — criar credenciais em console.cloud.google.com (OAuth 2.0 Client ID).
# client_id é público (fica no front também). client_secret SOMENTE no servidor.
GOOGLE_CLIENT_ID=[DIGITE SEU GOOGLE CLIENT ID AQUI]
GOOGLE_CLIENT_SECRET=[DIGITE SEU GOOGLE CLIENT SECRET AQUI]

# Domínios que podem chamar a API (separados por vírgula). SEM barra final.
# Ex: https://app.lifemaps.pro,https://lifemaps.pro
CORS_ORIGINS=[DIGITE SEUS DOMINIOS AQUI]

# Domínio do TSL automático do Caddy (reverse proxy). Apontar o DNS A p/ a VPS antes.
DOMAIN=api.lifemaps.pro
# (Opcional, só para servir o front estático pelo Caddy — bloco comentado no Caddyfile.prod)
# APP_DOMAIN=app.lifemaps.pro

# Limites de segurança
DOC_MAX_BYTES=5242880
RATE_LOGIN_PER_MIN=10
RATE_DOC_PUT_PER_MIN=60
# APP_ENV=dev faz o /forgot-password devolver o reset token no corpo (útil em testes locais).
# Em produção (padrão), o token só vai pro log/SMTP. NUNCA use dev em produção.
APP_ENV=production
# Validade do token de redefinição de senha (segundos). Padrão: 30 min.
PASSWORD_RESET_MAX_AGE=1800

# Deploy local: troque o host da DATABASE_URL para localhost (fora do Docker).